jQuery(function($) {
          $('.content-link').click(function() {
          $('.content-link').removeClass("active");
          $(this).addClass("active");
           var contTarget = $(this).attr('href');
      $('.content-section> div').hide();
      $(contTarget).show();
      });
});

// Fix RevSlider full-width on initial load.
// RevSlider calculates its canvas using documentElement.clientWidth (excludes scrollbar),
// but the stretched section is 100vw (includes scrollbar area). Firing a resize event
// after RevSlider finishes initialization forces it to recalculate to the correct width.
jQuery(window).on('load', function() {
    // Primary: hook RevSlider's own "loaded" event for immediate correction
    jQuery(document).on('revolution.slide.onloaded', function() {
        window.dispatchEvent(new Event('resize'));
    });
    // Fallback: fire resize at 300ms and 800ms to catch slow-initializing sliders
    setTimeout(function() { window.dispatchEvent(new Event('resize')); }, 300);
    setTimeout(function() { window.dispatchEvent(new Event('resize')); }, 800);
});
